{
  "name": "penda",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:edge",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:web && npm run test:mobile && npm run test:money-core && npm run test:edge",
    "supabase": "supabase",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "ios": "npm run ios --workspace=apps/mobile",
    "android": "npm run android --workspace=apps/mobile",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck:mobile": "npm run typecheck --workspace=apps/mobile",
    "typecheck:edge": "cd supabase/functions && deno check */index.ts",
    "test:web": "npm run test --workspace=apps/web",
    "test:money-core": "npm run test --workspace=@penda/money-core",
    "test:mobile": "npm run test --workspace=apps/mobile",
    "test:edge": "deno test --allow-env supabase/functions/_shared",
    "gen:types": "supabase gen types typescript --linked > supabase/functions/_shared/database.types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "supabase": "^2.109.1"
  }
}
